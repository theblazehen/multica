# Production variant of this fork points at Jasmin's self-hosted Multica.
# Loaded ahead of .env.production by the `*:prod` scripts (dotenv-cli gives the
# first file precedence). Committed on purpose: this fork exists for that
# instance. See .env.production.example for the template.
EXPO_PUBLIC_API_URL=https://project.blazelight.dev
EXPO_PUBLIC_WEB_URL=https://project.blazelight.dev
# Push notifier for inbox items (Android; see README "Push notifications").
EXPO_PUBLIC_PUSH_URL=https://project.blazelight.dev/push
